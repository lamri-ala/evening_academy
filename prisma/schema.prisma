// Evening Academy Management System — Phase 1 schema
// Decisions locked in during PRD review:
//   - Local-first, single-desktop deployment (SQLite file)
//   - Pricing model: per-subject (Subject.sessionPrice)
//   - No teacher login in v1 (admins print teacher statements)
//   - Bilingual French + Arabic (RTL) from day 1
//
// Money is stored as INTEGER minor units (centimes / santimat) to avoid floats.
// Append-only ledger tables are deliberately included in the schema but not
// exposed in Phase 1 UI — they are the spine Phase 2 (attendance + balances)
// will sit on top of. Student.cachedBalance is a derived field; never mutate
// it outside a transaction that also writes a StudentLedgerEntry.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- Auth ----------

enum UserRole {
  DIRECTOR
  STAFF
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(STAFF)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  studentLedgerEntries StudentLedgerEntry[] @relation("StudentLedgerRecordedBy")
  teacherLedgerEntries TeacherLedgerEntry[] @relation("TeacherLedgerRecordedBy")
  auditLogs            AuditLog[]
}

// ---------- Academic entities ----------

model Subject {
  id                 String   @id @default(cuid())
  name               String   @unique
  code               String?  @unique
  // Per-subject session price, in minor units (e.g. centimes DZD).
  sessionPrice       Int
  // Optional default teacher rate per session for this subject. Can be
  // overridden per-teacher in a future phase.
  defaultTeacherRate Int?
  color              String?
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  timetableSlots TimetableSlot[]
}

model Classroom {
  id        String   @id @default(cuid())
  name      String   @unique
  capacity  Int?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  timetableSlots TimetableSlot[]
}

model Student {
  id            String   @id @default(cuid())
  // Human-readable code, also used for barcode/QR printing later.
  code          String   @unique
  firstName     String
  lastName      String
  phone         String?
  guardianName  String?
  guardianPhone String?
  notes         String?
  // Cached balance in minor units. DERIVED: equals sum of
  // StudentLedgerEntry.amount for this student. Only mutated inside the
  // same transaction that writes a ledger entry. Phase 1 has no writes
  // against this field; it is included so Phase 2 can turn it on without
  // a migration.
  cachedBalance Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ledgerEntries StudentLedgerEntry[]
}

model Teacher {
  id            String   @id @default(cuid())
  firstName     String
  lastName      String
  phone         String?
  email         String?
  // Default session rate in minor units. Per-subject overrides later.
  sessionRate   Int      @default(0)
  notes         String?
  // Cached balance = total earned - total paid, in minor units.
  cachedBalance Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  timetableSlots TimetableSlot[]
  ledgerEntries  TeacherLedgerEntry[]
}

// ---------- Timetable (Phase 1 UI target) ----------

// dayOfWeek: 0=Sunday ... 6=Saturday, matching JS Date#getDay().
model TimetableSlot {
  id          String   @id @default(cuid())
  dayOfWeek   Int
  // Minutes since midnight, local time. 18:30 = 1110.
  startMinute Int
  endMinute   Int
  subjectId   String
  teacherId   String
  classroomId String
  label       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subject   Subject   @relation(fields: [subjectId], references: [id])
  teacher   Teacher   @relation(fields: [teacherId], references: [id])
  classroom Classroom @relation(fields: [classroomId], references: [id])

  @@index([dayOfWeek, startMinute])
  @@index([teacherId, dayOfWeek])
  @@index([classroomId, dayOfWeek])
}

// ---------- Append-only ledgers (schema present, UI deferred to Phase 2) ----------

enum StudentLedgerKind {
  PAYMENT
  SESSION_CHARGE
  ADJUSTMENT
  REFUND
}

model StudentLedgerEntry {
  id           String            @id @default(cuid())
  studentId    String
  kind         StudentLedgerKind
  // Positive for credits, negative for debits. Minor units.
  amount       Int
  balanceAfter Int
  reason       String?
  recordedById String
  createdAt    DateTime          @default(now())

  student    Student @relation(fields: [studentId], references: [id])
  recordedBy User    @relation("StudentLedgerRecordedBy", fields: [recordedById], references: [id])

  @@index([studentId, createdAt])
}

enum TeacherLedgerKind {
  EARNING
  PAYMENT
  ADJUSTMENT
}

model TeacherLedgerEntry {
  id           String            @id @default(cuid())
  teacherId    String
  kind         TeacherLedgerKind
  amount       Int
  balanceAfter Int
  reason       String?
  recordedById String
  createdAt    DateTime          @default(now())

  teacher    Teacher @relation(fields: [teacherId], references: [id])
  recordedBy User    @relation("TeacherLedgerRecordedBy", fields: [recordedById], references: [id])

  @@index([teacherId, createdAt])
}

// ---------- Audit log ----------

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  entity    String
  entityId  String
  payload   String?
  createdAt DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@index([actorId, createdAt])
}
